{
  "name": "gta6-rp-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "Open-source, community-led roleplay foundations for a possible future authorized GTA VI ecosystem.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint apps packages adapters tests",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "verify": "bash scripts/verify-local.sh",
    "verify:fast": "bash scripts/verify-local.sh --fast",
    "check:artifacts": "bash scripts/check-no-proprietary-artifacts.sh",
    "check:secrets": "bash scripts/check-no-secrets.sh",
    "check:site": "bash scripts/check-site-integrity.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gta6-rp/contracts": "workspace:*",
    "@gta6-rp/core": "workspace:*",
    "@gta6-rp/simulator": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "11.0.1",
      "source-map-js": "1.2.2",
      "vite": "7.3.8"
    }
  }
}
