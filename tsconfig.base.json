{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@gta6-rp/core": ["packages/core/src/index.ts"],
      "@gta6-rp/contracts": ["packages/contracts/src/index.ts"],
      "@gta6-rp/simulator": ["adapters/simulator/src/index.ts"]
    }
  }
}
